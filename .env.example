# Claude Code CLI
ANTHROPIC_API_KEY=sk-ant-...

# Codex CLI
OPENAI_API_KEY=sk-...

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=skillshub-artifacts

# Database
DATABASE_URL=postgresql://skillshub:skillshub@localhost:5432/skillshub

# Runner
RUNNER_WORKDIR_BASE=/tmp/skillshub-runs
RUNNER_TIMEOUT_DEFAULT=300
RUNNER_MAX_OUTPUT_SIZE_MB=100
