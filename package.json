{
  "name": "skillshub",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "db:generate": "pnpm --filter @skillshub/db exec prisma generate",
    "db:migrate": "pnpm --filter @skillshub/db exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @skillshub/db exec prisma migrate deploy",
    "db:push": "pnpm --filter @skillshub/db exec prisma db push"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
